# 可选：把 .env.example 复制为 .env，然后使用启动脚本自动读取。
# 默认仅允许本机访问，不要公开管理接口。
HOST=127.0.0.1
PORT=3218
AIHOT_BASE=https://aihot.news
SYNC_INTERVAL_SECONDS=3600
# 飞书群自定义机器人 Webhook，仅存储于本地或服务端环境变量，禁止提交到 GitHub。
FEISHU_WEBHOOK_URL=
# 线上公开可访问的网站地址，供飞书消息打开；本地测试可暂时留空。
PUBLIC_URL=

# 可选：GitHub Trending 英文简介自动翻译为中文。需自备 DeepSeek API 密钥并承担相应费用。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# GitHub Star 授权（可选）。需要具备 Star 权限的个人访问令牌。
# 请在 GitHub 中自行生成并仅保存在本机 .env，不要粘贴进聊天或公开仓库。
GITHUB_TOKEN=
# GitHub Trending 热度门槛：必须上榜且仓库累计 Star 达到此数值。
GITHUB_MIN_STARS=500

# 建立 AI Daily 开源仓库后填写，此处尚未创建仓库。
GITHUB_REPO_URL=
